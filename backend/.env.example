# On Railway, set these as service variables. Locally, copy this to .env.
#
# Never put a real value in THIS file -- it is committed. Placeholders only.

# Railway injects this when you attach the Postgres addon, so leave it unset
# there. Unset locally, the API falls back to a SQLite file.
DATABASE_URL=

# Shared key. Both the detector and the app send it as X-API-Key.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# The account the app logs in with.
DRIVER_USERNAME=driver
DRIVER_PASSWORD=
DRIVER_NAME=Driver
