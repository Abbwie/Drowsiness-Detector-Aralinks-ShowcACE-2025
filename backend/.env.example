# Shared key. Both the detector and the app send it as X-API-Key.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# The account the app logs in with.
DRIVER_USERNAME=abigail
DRIVER_PASSWORD= 12345678
